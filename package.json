{
  "name": "novex",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node scripts/check-public-assets.mjs && vite --host 127.0.0.1",
    "build": "node scripts/check-public-assets.mjs && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "check:assets": "node scripts/check-public-assets.mjs",
    "test": "node --test tests/*.test.js",
    "lint": "eslint src tests eslint.config.js vite.config.js scripts/check-public-assets.mjs scripts/create-public-inventory.mjs scripts/product-preview-recipe.mjs scripts/audit-release.mjs scripts/audit-security-preview.mjs scripts/run-browser-audit.mjs scripts/package-release.mjs",
    "test:browser": "node scripts/run-browser-audit.mjs"
  },
  "dependencies": {
    "gsap": "3.15.1",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "playwright": "^1.65.0",
    "vite": "8.3.6"
  },
  "overrides": {
    "eslint": {
      "minimatch": "11.0.1"
    },
    "@eslint/config-array": {
      "minimatch": "11.0.1"
    }
  },
  "license": "UNLICENSED"
}
